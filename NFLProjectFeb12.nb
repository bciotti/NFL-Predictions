     " ", "so", " ", 
    RowBox[{"let", "'"}], "s", " ", "use", " ", "that", " ", "as", " ", "the",
     " ", "size", " ", "of", " ", "our", " ", "training", " ", "set", " ", 
    "and", " ", "reserve", " ", "the", " ", "rest", " ", "for", " ", 
    RowBox[{"testing", ".", "  ", "First"}], " ", "I", " ", "set", " ", "a", " ",
     "seed", " ", "for", " ", 
    RowBox[{"reproducibility", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
