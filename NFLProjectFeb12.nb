       "=", "\"\<team_away_id\>\""}]}], "}"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.979655328853655*^9, 3.9796553950043697`*^9}, 
   3.9798265721478577`*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"ded26b55-a3c8-1c48-ab1e-438027493627"],

Cell[TextData[{
 "We are interested in whether the total number of points scored is less than \
the \[OpenCurlyDoubleQuote]over_under_line\[CloseCurlyDoubleQuote] that is \
set by the bookies so let\[CloseCurlyQuote]s append a column containing a \
Boolean of whether that was the case. \n\n",
 StyleBox["Note",
  FontWeight->"Bold"],
 ": An alternate approach would be to use True or False symbols, or \
\[OpenCurlyDoubleQuote]True\[CloseCurlyDoubleQuote] or \
\[OpenCurlyDoubleQuote]False\[CloseCurlyDoubleQuote] strings, instead of 0s \
and 1s.  I\[CloseCurlyQuote]ll go with integer 0s and 1s but in a longer \
analysis I would try the other approaches and compare the results. "
}], "Text",
 CellChangeTimes->{{3.979655417392029*^9, 3.9796555076648617`*^9}, 
   3.9796556870101433`*^9, {3.979806870888983*^9, 3.979806886451622*^9}, {
   3.9798069314978065`*^9, 3.979807058753536*^9}, {3.979895192169979*^9, 
   3.979895327965975*^9}, 
   3.979946053715681*^9},ExpressionUUID->"b17d5e5c-5b3a-a748-bbd4-\
886f44d30f46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"withUnder", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"Boole", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"6", ";;", "7"}], "]"}], "]"}], "]"}], "<", 
           RowBox[{"ToExpression", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "11", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "&"}], 
      ",", "namesToIds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "and", " ", "label", " ", "the", " ", "column", " ", "\"\<over_hit\>\""}],
     ":"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"withUnder", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}], "=", "\"\<under_hit\>\""}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9796557744989796`*^9, 3.979655830170456*^9}, {
  3.9798135857510777`*^9, 3.979813602069212*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"d7a1905a-16b6-2c42-865a-25b120e3b71c"],

