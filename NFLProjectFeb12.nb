Cell[CellGroupData[{

Cell["Improving the accuracy of the classifier net", "Subsection",
 CellChangeTimes->{{3.979908363355007*^9, 3.979908366885462*^9}, {
  3.9799250467849827`*^9, 3.9799250684082127`*^9}, {3.979945334585903*^9, 
  3.9799453370666103`*^9}},ExpressionUUID->"838cc999-0124-464a-99f7-\
9daca2bbdb98"],

Cell["\<\
The following code was taken from the section of \
https://resources.wolframcloud.com/NeuralNetRepository/resources/Self-\
Normalizing-Net-for-Numeric-Data/ on \[OpenCurlyDoubleQuote]Improving \
accuracy of the classifier net\[CloseCurlyDoubleQuote] and the idea is to run \
multiple trainings and create an ensemble network which averages the outputs \
of the trained nets:\
\>", "Text",
 CellChangeTimes->{{3.9799247141685295`*^9, 3.9799247187873783`*^9}, {
  3.979924887264557*^9, 3.9799249240952015`*^9}, {3.979924961315405*^9, 
  3.9799249762830963`*^9}, {3.9799424523850594`*^9, 
  3.9799424550504055`*^9}},ExpressionUUID->"2bbb6f58-be65-ff4c-8201-\
f91d96f4a1d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ensembleNet", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "ens", "}"}], ",", 
     RowBox[{
      RowBox[{"ens", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"NetTrain", "[", 
          RowBox[{
           RowBox[{"NetReplacePart", "[", 
            RowBox[{"netTF", ",", 
             RowBox[{"\"\<Output\>\"", "->", "dec"}]}], "]"}], ",", 
           RowBox[{"trainInputFE", "->", "trainOutputTF"}], ",", 
           RowBox[{"ValidationSet", "->", 
            RowBox[{"Scaled", "[", "0.05", "]"}]}], ",", 
           RowBox[{"MaxTrainingRounds", "->", "100"}], ",", 
           RowBox[{"RandomSeeding", "->", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"10", "^", "6"}], "]"}], "+", "n"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"NetGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sequence", "@@", "ens"}], ",", 
          RowBox[{"TotalLayer", "[", "]"}], ",", 
          RowBox[{"ElementwiseLayer", "[", 
           RowBox[{
            RowBox[{"#", "/", 
             RowBox[{"N", "@", "n"}]}], "&"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], "->", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], "->", 
           RowBox[{
            RowBox[{"n", "+", "1"}], "->", 
            RowBox[{"n", "+", "2"}]}]}]}], "}"}], ",", 
        RowBox[{"\"\<Output\>\"", "->", "dec"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
