         RowBox[{"column", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"Tally", "[", 
          RowBox[{"Head", " ", "/@", " ", 
           RowBox[{"column", "[", 
            RowBox[{"[", 
             RowBox[{"2", " ", ";;"}], "]"}], "]"}]}], "]"}]}], "}"}]}], 
      "]"}], ",", 
