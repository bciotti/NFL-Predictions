    RowBox[{
     RowBox[{"(", 
      RowBox[{"predictions", "-", "testOutput"}], ")"}], "^", "2"}], "]"}], 
   ")"}], "^", ".5"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"This", " ", "is", " ", "equivalent", " ", "to", " ", "\[IndentingNewLine]", 
