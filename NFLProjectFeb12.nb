Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coerced", "=", 
    RowBox[{"Map", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "->", 
            RowBox[{"ToExpression", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"10", "->", 
            RowBox[{"N", "[", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "10", "]"}], "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"12", "->", 
            RowBox[{"Boole", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "12", "]"}], "]"}], "]"}]}]}], "}"}]}], "]"}], " ",
        "&"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Rest", "[", "noPlayoffCol", "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"adding", " ", "back", " ", "the", " ", 
    RowBox[{"header", ":"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coerced", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{"coerced", ",", " ", 
     RowBox[{"noPlayoffCol", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9796625789409065`*^9, 3.9796626149507866`*^9}, {
   3.979662750681185*^9, 3.9796627528634033`*^9}, {3.9796629135823975`*^9, 
