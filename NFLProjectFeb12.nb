Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "schedule_playoff", " ", "column", " ", "is", " ", "now", " ", 
    "meaningless", " ", "since", " ", "every", " ", "value", " ", "is", " ", 
    "False", " ", "so", " ", "we", " ", "may", " ", "as", " ", "well", " ", 
    "drop", " ", "that", " ", "entire", " ", "column"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"noPlayoffCol", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"{", "4", "}"}]}], "]"}], "&"}], "/@", "noPlayoff"}]}], 
   ";"}]}]], "Input",
