Cell[TextData[{
 "In my randomization it appears that both the LinearRegression and NeuralNet \
models generated by Predict correctly suggest betting on the under. \n\n",
 StyleBox["This may suffice for Level 2 Certification but \
I\[CloseCurlyQuote]ve included some additional work in the supplemental \
sections that follow.\n-Ben Ciotti",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9799302943696327`*^9, 3.979930329309471*^9}, {
  3.979944389393648*^9, 3.979944423337099*^9}, {3.979947591849186*^9, 
  3.9799475956411304`*^9}},ExpressionUUID->"8dce4990-7506-1e44-8186-\
756673eb23c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplement 1: An alternate approach using a classification net\
\>", "Section",
 CellChangeTimes->{{3.979830884225975*^9, 3.979830887585636*^9}, {
  3.9799080785819683`*^9, 3.979908083328392*^9}, {3.979922586962305*^9, 
  3.9799225998819084`*^9}, {3.9799226623917046`*^9, 3.979922672088196*^9}, {
  3.97992995647826*^9, 3.9799299568643036`*^9}, {3.979943059405594*^9, 
  3.9799430595481853`*^9}},ExpressionUUID->"422e17a8-758c-8745-ab5e-\
3bcee88cefcb"],

Cell["\<\
I mentioned previously that perhaps I should be using a classification net on \
True or False outcomes instead of integer 1\[CloseCurlyQuote]s or 0\
\[CloseCurlyQuote]s.  Here I try that approach to see if it works better.  \
\>", "Text",
 CellChangeTimes->{{3.9799226027352123`*^9, 3.979922723764906*^9}, {
  3.979942385838749*^9, 
  3.9799423942040005`*^9}},ExpressionUUID->"417644cb-ee71-774c-b6dc-\
9771b24b2ec2"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Replace", " ", "the", " ", "0", " ", "and", " ", "1", " ", "outputs", " ",
     "with", " ", "False", " ", "and", " ", "True", " ", "symbols", " ", "in",
     " ", "the", " ", "trainOutput", " ", "and", " ", "testOutput", " ", 
    "sets"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"trainOutputTF", "=", 
     RowBox[{"Replace", "[", 
      RowBox[{"trainOutput", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "->", "True"}], ",", 
         RowBox[{"0", "->", "False"}]}], "}"}], ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testOutputTF", "=", 
     RowBox[{"Replace", "[", 
      RowBox[{"testOutput", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "->", "True"}], ",", 
         RowBox[{"0", "->", "False"}]}], "}"}], ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.979925918690569*^9, 3.9799259569802303`*^9}, {
   3.979926045467474*^9, 3.979926059146488*^9}, {3.979926102067461*^9, 
   3.9799261198584766`*^9}, 3.979926617327215*^9},
 CellTags->"ChatGeneratedCell",
 CellLabel->"In[63]:=",ExpressionUUID->"716a0ab6-292a-854d-a805-21c695568305"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "my", " ", "decoder", " ", "for", " ", "the", " ", "True", " ",
     "and", " ", "False", " ", 
    RowBox[{"classes", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dec", "=", 
    RowBox[{"NetDecoder", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Class\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9798982856441135`*^9, 3.979898299568781*^9}, {
   3.979898354791174*^9, 3.9798983637101383`*^9}, {3.9799228882095413`*^9, 
   3.9799229095266457`*^9}, 3.979930098510874*^9},
 CellLabel->"In[65]:=",ExpressionUUID->"14605375-9f3b-064d-bfb7-bf87a6df2ab4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "my", " ", "net"}], ",", " ", 
    RowBox[{
    "using", " ", "parameter", " ", "values", " ", "established", " ", 
     "through", " ", "testing"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"netTF", "=", 
   RowBox[{"NetModel", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Self-Normalizing Net for Numeric Data\>\"", ",", " ", 
      RowBox[{"\"\<DropoutProbability\>\"", "->", ".01"}], ",", " ", 
      RowBox[{"\"\<Depth\>\"", "->", "9"}], ",", " ", 
