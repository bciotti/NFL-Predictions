Cell[CellGroupData[{

Cell["Supplement 2:  Averaging my regression nets", "Section",
 CellChangeTimes->{{3.9799427827242413`*^9, 3.9799427986578674`*^9}, {
  3.979943055238493*^9, 
  3.979943055298044*^9}},ExpressionUUID->"b44d32f6-9751-0147-b20e-\
f61b0fde6c09"],

Cell["\<\
I can average together multiple regression nets in much the way that I \
created an averaging ensemble of classifier nets:\
\>", "Text",
 CellChangeTimes->{{3.9799428003892536`*^9, 
  3.9799428660899563`*^9}},ExpressionUUID->"70c99cb9-8dad-4d4e-b047-\
4ba4dc924c69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ensembleNetReg", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ens", "}"}], ",", 
    RowBox[{
     RowBox[{"ens", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"NetTrain", "[", 
         RowBox[{"net", ",", 
          RowBox[{"trainInputFE", "->", "trainOutput"}], ",", 
          RowBox[{"ValidationSet", "->", 
           RowBox[{"Scaled", "[", "0.07", "]"}]}], ",", 
          RowBox[{"MaxTrainingRounds", "->", "100"}], ",", 
          RowBox[{"RandomSeeding", "->", 
           RowBox[{
            RowBox[{"RandomInteger", "[", 
             RowBox[{"10", "^", "6"}], "]"}], "+", "n"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"NetGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sequence", "@@", "ens"}], ",", 
         RowBox[{"TotalLayer", "[", "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", 
          RowBox[{
           RowBox[{"#", "/", 
            RowBox[{"N", "@", "n"}]}], "&"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], "->", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], "->", 
          RowBox[{
           RowBox[{"n", "+", "1"}], "->", 
           RowBox[{"n", "+", "2"}]}]}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9799429082888775`*^9, 3.9799429137023582`*^9}, 
   3.9799436757267246`*^9},
 CellLabel->"In[75]:=",ExpressionUUID->"260fa907-0f93-5348-984e-2e9bd4785009"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"Train", " ", "4", " ", "nets"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9799429289849796`*^9, 
  3.9799429326324215`*^9}},ExpressionUUID->"e3e26461-0519-d54a-a8fe-\
ef5b4d0eb719"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "4"}], ";"}], "\n", 
 RowBox[{"ensTrainedReg", "=", 
  RowBox[{"ensembleNetReg", "[", "n", "]"}]}]}], "Input",
 CellChangeTimes->{{3.979942954084469*^9, 3.9799429595547905`*^9}, {
  3.9799436432213173`*^9, 3.9799436432928734`*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"46097880-74d6-1a4a-a723-fd5a5df0e7c8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["NetGraph",
    "SummaryHead"], "[", 
