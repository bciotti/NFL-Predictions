   "It", " ", "can", " ", "be", " ", "determined", " ", "that", " ", "6", " ",
     "rows", " ", "have", " ", "null", " ", "over_under", "_lines", " ", "so",
     " ", 
    RowBox[{"let", "'"}], "s", " ", "delete", " ", 
    RowBox[{"those", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Dimensions", "[", "withUnder", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"noNulls", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"withUnder", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"ToExpression", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "11", "]"}], "]"}], "]"}], "=!=", "Null"}], " ", 
