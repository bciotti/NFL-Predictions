Cell[TextData[{
 "This shows that we should ",
 StyleBox["not",
  FontWeight->"Bold"],
 " ",
 "bet on the under, and ",
 StyleBox["this prediction was incorrect",
  FontWeight->"Bold"],
 " as the true point total was 29+13=42 which was indeed under the over/under \
line of 46.5. \n\nLet\[CloseCurlyQuote]s check the predictions of the Predict \
models:"
}], "Text",
 CellChangeTimes->{{3.9798330887050266`*^9, 3.979833159802984*^9}, {
  3.979833600252779*^9, 3.979833611270958*^9}, {3.9799302509344025`*^9, 
