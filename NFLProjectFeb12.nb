Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Let", "'"}], "s", " ", "check", " ", "what", " ", "types", " ", 
    "of", " ", "data", " ", "are", " ", "in", " ", "each", " ", 
    RowBox[{"column", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Dataset", "@", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"column", ",", 
