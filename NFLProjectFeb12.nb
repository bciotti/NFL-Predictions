Cell[CellGroupData[{

Cell["Applying my models to the Super Bowl:", "Section",
 CellChangeTimes->{{3.9798328500161953`*^9, 3.979832865750843*^9}, {
  3.97994522356155*^9, 
  3.9799452296680546`*^9}},ExpressionUUID->"e287f84a-0d74-7044-8b55-\
730493229c58"],

Cell["\<\
I looked up the date, teams, spread, over_under_line, stadium (which was \
neutral), weather_temperature, and weather_wind_mph for Super Bowl XV (which \
occurred last weekend as I write this).  I put the schedule_week as 18 since \
the season was 17 weeks long). \
\>", "Text",
 CellChangeTimes->{{3.979832906807966*^9, 3.979832966103554*^9}, {
  3.9798330179532776`*^9, 3.979833042600828*^9}, {3.979833335347576*^9, 
  3.979833377418419*^9}, {3.9799301868581696`*^9, 3.9799301877735634`*^9}, {
  3.979945268078163*^9, 
  3.979945279001993*^9}},ExpressionUUID->"e17735b0-7ae5-ce41-aeca-\
6b3702d7310c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sb", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"convertDateToAbsoluteTime", "[", "\"\<2/8/2026\>\"", "]"}], ",", 
    "2026", ",", "18", ",", " ", "\"\<NE\>\"", ",", "\"\<SEA\>\"", ",", 
    " ", "\"\<SEA\>\"", ",", " ", 
    RowBox[{"-", "4.5"}], ",", " ", "46.5", ",", " ", "\"\<Levi's Stadium\>\"",
     ",", " ", "1", ",", " ", "60", ",", " ", "7.5"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9798328832438526`*^9, 3.979832902108032*^9}, {
  3.9798330111190987`*^9, 3.9798330111627846`*^9}, {3.9799303373685665`*^9, 
