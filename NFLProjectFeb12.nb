Cell["\<\
I think it\[CloseCurlyQuote]s probably a good idea to coerce some of the \
data.  The schedule_date values are strings that look like \
\[OpenCurlyDoubleQuote]1/14/1968\[CloseCurlyDoubleQuote] and I would like to \
coerce them into numeric form.  I do so by converting the dates to absolute \
times (which are the number of seconds since January 1 1900):\
\>", "Text",
 CellChangeTimes->{{3.9796592761705284`*^9, 3.979659457733528*^9}, {
  3.9798089772926083`*^9, 3.979808979050558*^9}, {3.979826887969551*^9, 
  3.979826889014122*^9}},ExpressionUUID->"05336351-6dbc-ff41-b318-\
ff45ec7e4f05"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "define", " ", "function", " ", "which", " ", "takes", " ", "in", " ", "a",
     " ", "date", " ", "string", " ", "and", " ", "spits", " ", "out", " ", 
    "and", " ", "absolute", " ", "time"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"convertDateToAbsoluteTime", "[", "dateString_", "]"}], ":=", 
     RowBox[{"AbsoluteTime", "[", 
      RowBox[{"DateObject", "[", 
       RowBox[{"{", 
        RowBox[{"dateString", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Month\>\"", ",", "\"\<Day\>\"", ",", "\"\<Year\>\""}], 
          "}"}]}], "}"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Apply", " ", "to", " ", "my", " ", 
     RowBox[{"dataset", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"absoluteTime", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"1", "->", 
          RowBox[{"convertDateToAbsoluteTime", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "]"}], "&"}], "/@", 
      RowBox[{"Rest", "[", "noNulls", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Add", " ", "back", " ", "the", " ", 
     RowBox[{"header", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"absoluteTime", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{"absoluteTime", ",", " ", 
       RowBox[{"noNulls", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9796594696437836`*^9, 3.979659574978611*^9}, 
   3.9799384210595264`*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"7ed2179d-4269-7945-965c-dddab17029f1"],

Cell[TextData[{
 "Now I remove playoff games.  This is because they don\[CloseCurlyQuote]t \
have an integer value for the week and I don\[CloseCurlyQuote]t want to deal \
with this so I will avoid such cases by just deleting them from my data.  \n\n\
",
 StyleBox["Note",
  FontWeight->"Bold"],
 ": A more sophisticated approach might be to replace them with a week number \
but this would take some effort to accurately implement being as, e.g., the \
NFL has changed the number of weeks in a season over the years.  "
}], "Text",
 CellChangeTimes->{{3.979659615267206*^9, 3.9796596303822803`*^9}, {
  3.979659674545664*^9, 3.979659730060892*^9}, {3.9796597866457634`*^9, 
  3.97965986218198*^9}, {3.9796605549291134`*^9, 3.9796605578063526`*^9}, {
  3.979662892229471*^9, 3.9796629045845795`*^9}, {3.9798283020224648`*^9, 
  3.9798283030993176`*^9}, {3.9798955388789673`*^9, 
  3.9798956618997784`*^9}},ExpressionUUID->"1a122e8e-f37e-9947-817d-\
09a62f768996"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Deleting", " ", "playoff", " ", 
    RowBox[{"games", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"noPlayoff", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"absoluteTime", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "=!=", "True"}], "&"}]}], "]"}]}], 
   " ", ";"}]}]], "Input",
 CellChangeTimes->{{3.9796596484296455`*^9, 3.97965966463603*^9}, 
   3.979662528161022*^9, {3.979663169123581*^9, 3.97966317916556*^9}, 
   3.979938437199768*^9},
