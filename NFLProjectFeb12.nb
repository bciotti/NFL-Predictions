Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "accuracy", " ", "of", " ", "our", " ", 
    "ensemble", " ", "net"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"N", "@", 
    RowBox[{"Mean", "@", 
     RowBox[{"Boole", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Equal", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ensTrained", "[", "testInputFE", "]"}], ",", " ", 
          "testOutputTF"}], "}"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Equivalently", " ", "this", " ", "can", " ", "be", " ", "computed", " ",
       "as", "\[IndentingNewLine]", "accensemble"}], "=", 
     RowBox[{"ClassifierMeasurements", "[", 
      RowBox[{"ensTrained", ",", 
       RowBox[{"testInputFE", "->", "testOutputTF"}], 
       ",", "\"\<Accuracy\>\""}], "]"}]}], "\[IndentingNewLine]", 
    "*)"}]}]}]], "Input",
