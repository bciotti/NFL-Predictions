Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "For", " ", "comparison", " ", "overs", " ", "hit", " ", "about", " ", 
     "48.7", "%", " ", "of", " ", "the", " ", "time", " ", "and", " ", 
     RowBox[{"over", "/", "unders"}], " ", "are", " ", "a", 
     " ", "\"\<push\>\"", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"i", ".", "e", ".", " ", "exactly"}], " ", "as", " ", 
       "predicted"}], ")"}], " ", "about", " ", "1.85", "%", " ", "of", " ", 
     "the", " ", 
     RowBox[{"time", ".", " ", "This"}], " ", "is", " ", "infrequent", " ", 
     "because", " ", "the", " ", "over_under", "_line", " ", "typically", " ",
      "ends", " ", "in", " ", ".5", " ", "rendering", " ", "it", " ", 
     "impossible", " ", "for", " ", "the", " ", "total", " ", "points", " ", 
     "to", " ", "equal", " ", "it"}], ",", " ", 
    RowBox[{
    "and", " ", "even", " ", "if", " ", "the", " ", "over_under", "_line", " ", 
     StyleBox["is",
      FontSlant->"Italic"], " ", "an", " ", "integer", " ", "it", " ", "is", " ",
      "still", " ", "unlikely", " ", "that", " ", "the", " ", "total", " ", 
     "points", " ", "scored", " ", "to", " ", "end", " ", "up", " ", 
     "equalling", " ", "it", " ", 
     RowBox[{"exactly", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"overHitProbability", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"6", ";;", "7"}], "]"}], "]"}], "]"}], ">", 
          RowBox[{"ToExpression", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "11", "]"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"noNulls", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"pushProbability", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"6", ";;", "7"}], "]"}], "]"}], "]"}], "==", 
          RowBox[{"ToExpression", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "11", "]"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"noNulls", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}]}]}]}]], "Input",
