Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Setting", " ", "a", " ", "seed", " ", "and", " ", "training", " ", "the", 
    " ", 
    RowBox[{"net", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"netTrained", "=", 
    RowBox[{"NetTrain", "[", 
     RowBox[{"net", ",", 
      RowBox[{"trainInputFE", "->", "trainOutput"}], ",", "All", ",", " ", 
      RowBox[{"ValidationSet", "->", 
       RowBox[{"Scaled", "[", "0.07", "]"}]}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<ADAM\>\"", ",", " ", 
         RowBox[{"\"\<L2Regularization\>\"", "->", ".001"}]}], "}"}]}], ",", 
      RowBox[{"BatchSize", "->", "200"}], ",", 
      RowBox[{"TrainingStoppingCriterion", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Criterion\>\"", "\[Rule]", "\"\<Loss\>\""}], ",", 
         RowBox[{"\"\<Patience\>\"", "\[Rule]", "50"}]}], "|>"}]}]}], 
     "]"}]}]}]}]], "Input",
